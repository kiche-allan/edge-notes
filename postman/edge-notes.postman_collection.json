{
  "info": {
    "name": "Edge Notes API",
    "description": "Every endpoint of the Edge Notes site. Set baseUrl to http://<VPS-IP>:8080 (or http://localhost:3000 locally).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "round",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect([200]).to.include(pm.response.code));",
                  "pm.test('db ok', () => pm.expect(pm.response.json().db).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Subscribe",
      "item": [
        {
          "name": "Subscribe (valid)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/subscribe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscribe"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman-test@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 201', () => pm.expect([200,201]).to.include(pm.response.code));",
                  "pm.test('ok', () => pm.expect(pm.response.json().ok).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Subscribe (invalid email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/subscribe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscribe"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.expect([400]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Margin notes",
      "item": [
        {
          "name": "List notes for a post",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notes?post=why-one-scheduler-isnt-enough",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notes"
              ],
              "query": [
                {
                  "key": "post",
                  "value": "why-one-scheduler-isnt-enough"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect([200]).to.include(pm.response.code));",
                  "pm.test('notes array', () => pm.expect(pm.response.json().notes).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add a note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"post\": \"why-one-scheduler-isnt-enough\",\n  \"name\": \"Postman\",\n  \"body\": \"Test note from Postman.\",\n  \"quote\": \"the car has already moved on\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.expect([201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add a note (unknown post)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"post\": \"no-such-post\",\n  \"name\": \"Postman\",\n  \"body\": \"x\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.expect([404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Ask the Notes",
      "item": [
        {
          "name": "Ask (covered)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ask"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How does PRISM decide where a task runs?\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect([200]).to.include(pm.response.code));",
                  "pm.test('answered with sources', () => { const j = pm.response.json(); pm.expect(j.answered).to.be.true; pm.expect(j.sources.length).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask (not covered)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ask"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"best banana bread recipe\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect([200]).to.include(pm.response.code));",
                  "pm.test('not answered', () => pm.expect(pm.response.json().answered).to.be.false);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Lab",
      "item": [
        {
          "name": "This week's board",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/lab/scores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "lab",
                "scores"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect([200]).to.include(pm.response.code));",
                  "pm.collectionVariables.set('round', pm.response.json().round);"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit a score",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/lab/scores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "lab",
                "scores"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"round\": \"{{round}}\",\n  \"handle\": \"postman\",\n  \"choices\": [\n    0,\n    1,\n    2,\n    0,\n    1,\n    2,\n    0,\n    1,\n    2,\n    0\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.expect([201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit invalid moves",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/lab/scores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "lab",
                "scores"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"round\": \"{{round}}\",\n  \"handle\": \"cheat\",\n  \"choices\": [\n    9\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.expect([400]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "USSD (Africa's Talking format)",
      "item": [
        {
          "name": "Main menu",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ussd",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ussd"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "sessionId",
                  "value": "pm-1"
                },
                {
                  "key": "serviceCode",
                  "value": "*384*0#"
                },
                {
                  "key": "phoneNumber",
                  "value": "+254700000000"
                },
                {
                  "key": "text",
                  "value": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect([200]).to.include(pm.response.code));",
                  "pm.test('opens a session', () => pm.expect(pm.response.text()).to.match(/^CON /));"
                ]
              }
            }
          ]
        },
        {
          "name": "Latest notes",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ussd",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ussd"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "sessionId",
                  "value": "pm-1"
                },
                {
                  "key": "phoneNumber",
                  "value": "+254700000000"
                },
                {
                  "key": "text",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CON', () => pm.expect(pm.response.text()).to.match(/^CON /));"
                ]
              }
            }
          ]
        },
        {
          "name": "Open note 1",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ussd",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ussd"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "sessionId",
                  "value": "pm-1"
                },
                {
                  "key": "phoneNumber",
                  "value": "+254700000000"
                },
                {
                  "key": "text",
                  "value": "1*1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('END with link', () => { const t = pm.response.text(); pm.expect(t).to.match(/^END /); pm.expect(t.length).to.be.at.most(182); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Kiswahili menu",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ussd",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ussd"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
