# Copied to .env by scripts/vps-setup.sh, which fills in a random password.
POSTGRES_USER=edge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=edge_notes
# DATABASE_URL is built from the values above inside docker-compose.yml
# Public port the site listens on (Piwigo keeps 80/443)
WEB_PORT=8080
# Full public address, used in RSS and USSD links. Change when you add a domain.
SITE_URL=http://YOUR_VPS_IP:8080
# Optional: shared secret Africa's Talking sends to /api/ussd (leave blank to accept all)
USSD_SECRET=
